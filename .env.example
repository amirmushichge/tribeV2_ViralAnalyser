# Optional. Defaults to %USERPROFILE%\Downloads\tribe_cache on Windows.
TRIBE_CACHE_DIR=

# Optional. Use only if Chrome is installed in a non-standard location.
TRIBE_CHROME_PATH=

# Optional. Ollama is used only for local copy rewriting when available.
OLLAMA_HOST=http://localhost:11434

# Required for the Worthy Cloud Run worker endpoint in worker.py.
# Use the Firebase Storage bucket name, for example worthy-compliance.firebasestorage.app.
FIREBASE_STORAGE_BUCKET=
