# Optional. Defaults to %USERPROFILE%\Downloads\tribe_cache on Windows and
# ~/Downloads/tribe_cache on macOS/Linux.
TRIBE_CACHE_DIR=

# Optional. Use only if Chrome is installed in a non-standard location.
TRIBE_CHROME_PATH=

# Optional. Device override for TRIBE inference: auto, cpu, cuda, or mps.
TRIBE_DEVICE=auto

# Optional. Device override for Whisper speech transcription: auto, cpu, cuda, or mps.
TRIBE_SPEECH_DEVICE=auto

# Optional. Enables Apple Silicon MPS as an experimental auto-selection target.
TRIBE_ENABLE_MPS=0

# Optional. Recommended when testing Apple Silicon MPS.
PYTORCH_ENABLE_MPS_FALLBACK=1

# Optional. Ollama is used only for local copy rewriting when available.
OLLAMA_HOST=http://localhost:11434
